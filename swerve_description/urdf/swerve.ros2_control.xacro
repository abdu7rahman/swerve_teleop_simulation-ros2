<?xml version="1.0" ?>
<!--
  ros2_control hardware description for the swerve base.

  Replaces swerve.trans, which declared eight transmission_interface/
  SimpleTransmission blocks. ROS 2 has no <transmission> equivalent — the
  command and state interfaces a joint exposes are declared directly.

  Joint roles, carried over from the ROS 1 controller.yaml and
  ros_controllers.yaml:
    Rev1, Rev3, Rev5, Rev7 -> steering (position)
    Rev2, Rev4, Rev6, Rev8 -> wheel drive (velocity)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="hardware" default="gazebo"/>
  <xacro:property name="hardware_type" value="$(arg hardware)"/>

  <ros2_control name="SwerveSystem" type="system">

    <xacro:if value="${hardware_type == 'mock'}">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
    </xacro:if>

    <xacro:if value="${hardware_type == 'gazebo'}">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
    </xacro:if>

    <xacro:macro name="steer_joint" params="name">
      <joint name="${name}">
        <command_interface name="position">
          <param name="min">-3.14</param>
          <param name="max">3.14</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>

    <xacro:macro name="wheel_joint" params="name">
      <joint name="${name}">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>

    <xacro:steer_joint name="Rev1"/>
    <xacro:steer_joint name="Rev3"/>
    <xacro:steer_joint name="Rev5"/>
    <xacro:steer_joint name="Rev7"/>

    <xacro:wheel_joint name="Rev2"/>
    <xacro:wheel_joint name="Rev4"/>
    <xacro:wheel_joint name="Rev6"/>
    <xacro:wheel_joint name="Rev8"/>

  </ros2_control>

</robot>
